# Copiar este archivo como .env y completar los valores reales
# cp .env.example .env

# ---------------------------------------------------------------
# Groq API — obtener clave en https://console.groq.com
# ---------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------
# Embedding — modelo multilingue ES/EN/ZH (se descarga automaticamente)
# EMBEDDING_DEVICE: "cuda" si tienes GPU NVIDIA, "cpu" si no
# ---------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cuda

# ---------------------------------------------------------------
# FAISS — ruta donde se guarda/carga el indice vectorial
# ---------------------------------------------------------------
FAISS_STORE_PATH=./faiss_store

# ---------------------------------------------------------------
# Datasets — rutas relativas desde la raiz del proyecto
# Descargar desde:
#   MedMCQA:      https://huggingface.co/datasets/openlifescienceai/medmcqa
#   MedQA:        https://github.com/jind11/MedQA
#   Multiclinsum: https://huggingface.co/datasets/vgaraujov/multiclinsum
# ---------------------------------------------------------------
DATASET_MEDMCQA_PATH=./datasets/data
DATASET_MEDQA_PATH=./datasets/data_clean/data_clean
DATASET_MULTICLINSUM_PATH=./datasets/multiclinsum_large-scale_train_es/multiclinsum_large-scale_train_es

# ---------------------------------------------------------------
# RAG
# ---------------------------------------------------------------
RAG_TOP_K=5

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------
# Telegram Bot — token del bot creado con @BotFather
# ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------
# Notifier — Skill de notificaciones por email SMTP
# ---------------------------------------------------------------
NOTIFIER_ENABLED=true
NOTIFIER_EMAIL_TO=destinatario@correo.com
NOTIFIER_SMTP_HOST=smtp.gmail.com
NOTIFIER_SMTP_PORT=587
NOTIFIER_SMTP_USER=tu_correo@gmail.com
NOTIFIER_SMTP_PASSWORD=tu_app_password

# ---------------------------------------------------------------
# Status Check Scheduler — mensajes automaticos de seguimiento
# Integrado en maternas_bot.py (JobQueue de python-telegram-bot).
# Un solo proceso — no requiere terminal ni servicio aparte.
#
# Cada usuario que le escribe al bot recibe un mensaje periodico tipo
# "check de estado". La frecuencia depende de su nivel de riesgo actual:
#   LOW    → cada STATUS_CHECK_INTERVAL_LOW_SECONDS    (default: 60s)
#   MEDIUM → cada STATUS_CHECK_INTERVAL_MEDIUM_SECONDS  (default: 45s)
#   HIGH   → cada STATUS_CHECK_INTERVAL_HIGH_SECONDS    (default: 30s)
#
# Valores bajos para desarrollo/pruebas. En produccion se sugiere:
#   LOW=3600 (1h), MEDIUM=1800 (30min), HIGH=300 (5min)
# ---------------------------------------------------------------
STATUS_CHECK_INTERVAL_LOW_SECONDS=60
STATUS_CHECK_INTERVAL_MEDIUM_SECONDS=45
STATUS_CHECK_INTERVAL_HIGH_SECONDS=30
STATUS_CHECK_MESSAGE=🩺 *Check de estado* — ¿Cómo te encuentras hoy? Cuéntame cualquier molestia o duda que tengas.
